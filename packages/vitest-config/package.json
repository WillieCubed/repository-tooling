{
  "name": "@williecubed/vitest-config",
  "version": "0.0.1",
  "description": "The Vitest configuration every personal repository spreads into its own.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/WillieCubed/repository-tooling.git",
    "directory": "packages/vitest-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "peerDependencies": {
    "vitest": ">=4"
  }
}
